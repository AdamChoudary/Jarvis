# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Required: cloud LLM lanes ---
# NVIDIA NIM key (https://build.nvidia.com/) — the daemon's main cloud reasoning
# lane. Also used by jarvis_nemori.py's knowledge-graph distillation.
NVIDIA_API_KEY=

# OpenCode Zen key (https://opencode.ai/zen) — the fast/low-latency reply lane.
# Also used by jarvis_nemori.py and the optional jarvis_pipecat.py pipeline.
OPENCODE_ZEN_KEY=

# --- Optional ---
# Picovoice Porcupine access key (https://console.picovoice.ai/) — only read
# by the legacy jarvis_voice_v7.py wake-word path. The current daemon
# (jarvis_ear.py) uses openWakeWord instead and doesn't need this.
PORCUPINE_ACCESS_KEY=

# Shared-secret key for the local Hermes agent API server the daemon talks to
# for the "AGENT" escalation path. Defaults to "jarvis-local-8642" if unset —
# only override this if you've changed it on the agent server side too.
API_SERVER_KEY=

# Force a specific mlx-whisper model repo instead of the default
# (mlx-community/whisper-base-mlx).
JARVIS_WHISPER_MODEL=

# Force a specific input audio device by (partial, case-insensitive) name
# instead of auto-detecting one.
JARVIS_AUDIO_DEVICE=

# Debugging escape hatches — leave unset in normal use:
#   JARVIS_LLM_FORCE=zen   forces the fast LLM lane for a turn
#   JARVIS_TTS_FORCE=<engine>   forces a specific TTS engine
# JARVIS_LLM_FORCE=
# JARVIS_TTS_FORCE=

# Set automatically by the test suite (tests/test_wave1.py) — don't set this
# yourself; it tags logged turns as test data so they're excluded from real
# latency stats.
# JARVIS_TEST_MODE=
